[Unit]
Description=OpenThinRDP: the device's secrets out of the TPM into memory (management folder, Wi-Fi, SSH host keys)
DefaultDependencies=no
# no Wants=tpm2.target: on Debian it waits up to 90 s for a TPM that a device may not have (secrets.sh waits
# for the TPM itself, only when the firmware declares one); the ordering stays for devices that have it
After=local-fs.target tpm2.target
Before=network-pre.target networking.service ssh.service openthinrdp-boot.service shutdown.target
Conflicts=shutdown.target

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStart=/opt/openthinrdp/secrets.sh

[Install]
WantedBy=multi-user.target
