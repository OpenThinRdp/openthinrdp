# OpenThinRDP: automatic installation (AUTO_INSTALL=yes in build.conf). It WIPES THE FIRST INTERNAL DISK without asking.
d-i debian-installer/locale string @LOCALE@
d-i keyboard-configuration/xkb-keymap select @KEYBOARD@
d-i console-setup/ask_detect boolean false

# Network: NOT configured during the installation (it installs offline from the medium). Otherwise, on a PC
# whose wired port has no link, the installer switches to Wi-Fi and stops asking for a WPA password.
# The thin client configures its network at the first boot.
d-i netcfg/enable boolean false
d-i netcfg/get_hostname string thinclient
d-i netcfg/hostname string thinclient

# No mirror: offline installation from the medium (live installer)
d-i apt-setup/use_mirror boolean false
d-i apt-setup/services-select multiselect
apt-cdrom-setup apt-setup/cdrom/set-first boolean false

d-i clock-setup/utc boolean true
d-i time/zone string @TIMEZONE@
d-i clock-setup/ntp boolean false

# Accounts: root disabled; "otradmin" (already in the image, with sudo) gets the console password of
# build.conf, or a locked password (SSH with a key only)
d-i passwd/root-login boolean false
d-i passwd/make-user boolean true
d-i passwd/user-fullname string Administrator
d-i passwd/username string otradmin
d-i passwd/user-password-crypted password @ADMIN_HASH@
d-i user-setup/encrypt-home boolean false

# Partitioning: the first INTERNAL disk (nvme0n1 / mmcblk0 / sda on SATA / vda), wiped completely. USB and
# removable disks are never chosen: the installation stick, or a USB key left plugged in, is often sda. eMMC
# boot and RPMB areas are not disks. No internal disk = no automatic choice: the installer asks.
d-i partman/early_command string \
  DISK=""; \
  for d in $(list-devices disk); do \
    n=${d##*/}; \
    case "$n" in *boot[0-9]|*rpmb) continue ;; esac; \
    readlink -f /sys/class/block/$n | grep -q /usb && continue; \
    [ "$(cat /sys/class/block/$n/removable 2>/dev/null)" = 1 ] && continue; \
    DISK=$d; break; \
  done; \
  if [ -n "$DISK" ]; then \
    debconf-set partman-auto/disk "$DISK"; \
    debconf-set grub-installer/bootdev "$DISK"; \
  fi; \
  [ -d /sys/firmware/efi ] || debconf-set grub-installer/skip true
d-i partman-auto/method string regular
d-i partman-auto/choose_recipe select atomic
d-i partman/alignment string optimal
d-i partman/choose_partition select finish
# Writing to the disk is NOT preseeded: the installer shows the disk and the partitions it is going to erase
# and asks, with "No" preselected. The "Unattended install" entry of the boot menu answers it on the kernel
# command line (partman/confirm=true ...), for rollouts on known hardware. The same goes for removing old LVM
# volumes or software RAID found on the disk: never without a question, except in the unattended entry.

# Packages: nothing more (everything comes from the live image)
tasksel tasksel/first multiselect
d-i pkgsel/include string
d-i pkgsel/upgrade select none
d-i pkgsel/update-policy select none
popularity-contest/participate boolean false

# Legacy BIOS (no /sys/firmware/efi): the image carries the Secure Boot chain (shim-signed, grub-efi-amd64-signed),
# and grub-installer stops when it tries to remove it for grub-pc (the signed GRUB is a protected package). So with a
# BIOS grub-installer is skipped (partman/early_command above) and here the EFI packages, useless without UEFI, are
# removed, grub-pc comes from the medium and goes onto the disk the partitioning used.
d-i preseed/late_command string \
  if [ ! -d /sys/firmware/efi ]; then \
    DISK=$(debconf-get partman-auto/disk); \
    [ -n "$DISK" ] || DISK=$(list-devices disk | head -n1); \
    in-target dpkg --purge --force-remove-protected --force-depends shim-signed shim-helpers-amd64-signed grub-efi-amd64-signed grub-efi-amd64-bin grub-efi-amd64 >/dev/null 2>&1; \
    echo "grub-pc grub-pc/install_devices multiselect $DISK" > /target/tmp/grub-pc.seed; \
    in-target debconf-set-selections /tmp/grub-pc.seed; rm -f /target/tmp/grub-pc.seed; \
    apt-install grub-pc && in-target grub-install --target=i386-pc "$DISK" && in-target update-grub; \
  fi
d-i grub-installer/only_debian boolean true
d-i grub-installer/with_other_os boolean true
d-i grub-installer/bootdev string default
d-i finish-install/keep-consoles boolean true
d-i finish-install/reboot_in_progress note
d-i cdrom-detect/eject boolean true
d-i debian-installer/exit/reboot boolean true
